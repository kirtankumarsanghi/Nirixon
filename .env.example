# Nirixon environment — copy to `.env` and adjust for your machine.
# Never commit real secrets.

ENVIRONMENT=development

# --- Database ---
# Local default (async SQLite). Docker compose overrides with Postgres.
DATABASE_URL=sqlite+aiosqlite:///./backend/nirixon_dev.db
# DATABASE_URL=postgresql+asyncpg://nirixon:nirixon@localhost:5432/nirixon

# --- Auth (minimal JWT; no registration flow yet) ---
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=1440
SEED_USER_EMAIL=parent@example.com
SEED_USER_PASSWORD=changeme

# --- CORS (comma-separated; do NOT use * in production) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend (Stage 5) ---
# Copy frontend/.env.example → frontend/.env
# VITE_API_BASE_URL=http://localhost:8000

# --- Session repository ---
# memory = InMemorySessionRepo (DEFAULT for Stage 4 local/dev)
#
# DEPLOY BLOCKER: InMemorySessionRepo is SINGLE-PROCESS / SINGLE-WORKER only.
# Do not run multiple Uvicorn --workers, multiple API replicas, or horizontal
# scale-out until RedisSessionRepo is implemented. Sessions will silently
# diverge across workers.
SESSION_REPO_BACKEND=memory

# Reserved for future RedisSessionRepo (not implemented in Stage 4)
# REDIS_URL=redis://localhost:6379/0

# --- ML artifacts (four pickle files from backend/ml/train.py) ---
ML_ARTIFACTS_DIR=backend/ml/artifacts

# --- Rate limiting (/api/screen/* and /api/predict) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
