# Nirixon environment — copy to `.env` and adjust for your machine.
# Never commit real secrets.

ENVIRONMENT=development

# --- Database ---
# Local default (async SQLite). Docker compose overrides with Postgres.
DATABASE_URL=sqlite+aiosqlite:///./backend/nirixon_dev.db
# DATABASE_URL=postgresql+asyncpg://nirixon:nirixon@localhost:5432/nirixon

# --- Auth (minimal JWT; no registration flow yet) ---
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=1440
SEED_USER_EMAIL=parent@example.com
SEED_USER_PASSWORD=changeme

# --- CORS (comma-separated; do NOT use * in production) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend (Stage 5) ---
# Copy frontend/.env.example → frontend/.env
# Leave VITE_API_BASE_URL unset for the web (Vite/nginx proxy /api and /audio).
# Set it only when the API is on another host or for the Capacitor build.
# VITE_API_BASE_URL=http://localhost:8000

# --- Session repository ---
# memory = InMemorySessionRepo (DEFAULT for single-worker local development)
# redis  = RedisSessionRepo (REQUIRED for multi-worker Uvicorn clustering and multi-replica production)
SESSION_REPO_BACKEND=memory

# Redis Connection URL (required when SESSION_REPO_BACKEND=redis)
# REDIS_URL=redis://localhost:6379/0
# SESSION_REDIS_PREFIX=nirixon:session:
# SESSION_TTL_SECONDS=86400

# --- ML artifacts (four pickle files from backend/ml/train.py) ---
ML_ARTIFACTS_DIR=backend/ml/artifacts
MODULE_B_DATA_DIR=backend/data/module_b
MODULE_B_ARTIFACT_DIR=backend/ml/artifacts/module_b_router

# --- Find Help facility directory (read-only SQLite, no patient data) ---
# Built by: python backend/scripts/find_help/import_reference_data.py
# NIRIXON_REFERENCE_DB=backend/data/find_help/reference.sqlite

# --- Rate limiting (/api/screen/* and /api/predict) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
