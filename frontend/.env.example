# Stage 5 frontend — copy to `.env` for local development.
# Leave VITE_API_BASE_URL unset for the web: Vite proxies /api and /audio to the
# backend, and nginx does the same in the Docker image. An absolute URL is only
# needed when the API is on another host or when building the Capacitor app.
# VITE_API_BASE_URL=http://127.0.0.1:8000
